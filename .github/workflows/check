name: Test AWS Login

on:
  workflow_dispatch:

jobs:
  test-aws:
    runs-on: ubuntu-latest

    steps:
      - name: Check secret lengths
        shell: bash
        env:
          ACCESS_KEY: ${{ secrets.AWS_ACCESS_KEY_ID }}
          SECRET_KEY: ${{ secrets.AWS_SECRET_ACCESS_KEY }}
        run: |
          echo "Access key length: ${#ACCESS_KEY}"
          echo "Secret key length: ${#SECRET_KEY}"

          if [ -z "$ACCESS_KEY" ]; then
            echo "AWS_ACCESS_KEY_ID is empty"
            exit 1
          fi

          if [ -z "$SECRET_KEY" ]; then
            echo "AWS_SECRET_ACCESS_KEY is empty"
            exit 1
          fi

          if [[ "$ACCESS_KEY" == *$'\n'* ]] || [[ "$ACCESS_KEY" == *$'\r'* ]]; then
            echo "Access key contains a line break"
            exit 1
          fi

          if [[ "$SECRET_KEY" == *$'\n'* ]] || [[ "$SECRET_KEY" == *$'\r'* ]]; then
            echo "Secret key contains a line break"
            exit 1
          fi

          echo "Secret values are present"

      - name: Configure AWS credentials
        uses: aws-actions/configure-aws-credentials@v6
        with:
          aws-access-key-id: ${{ secrets.AWS_ACCESS_KEY_ID }}
          aws-secret-access-key: ${{ secrets.AWS_SECRET_ACCESS_KEY }}
          aws-region: us-east-1
          retry-max-attempts: 2

      - name: Test AWS identity
        run: aws sts get-caller-identity
