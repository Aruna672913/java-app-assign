  infra:
    name: Provision Infrastructure
    runs-on: ubuntu-latest
    needs: build

    outputs:
      instance_id: ${{ steps.ec2.outputs.instance_id }}
      public_ip: ${{ steps.ec2.outputs.public_ip }}

    steps:
      - name: Configure AWS Credentials
        uses: aws-actions/configure-aws-credentials@e3dd6a429d7300a6a4c196c26e071d42e0343502
        with:
          aws-access-key-id: ${{ secrets.AWS_ACCESS_KEY_ID }}
          aws-secret-access-key: ${{ secrets.AWS_SECRET_ACCESS_KEY }}
          aws-region: ${{ secrets.AWS_REGION }}

      - name: Verify AWS Access
        run: aws sts get-caller-identity

      - name: Check Or Create EC2
        id: ec2
        env:
          AWS_KEY_NAME: ${{ secrets.AWS_KEY_NAME }}
        run: |
          set -e

          echo "Checking whether EC2 already exists..."

          INSTANCE_ID=$(aws ec2 describe-instances \
            --filters \
              "Name=tag:Name,Values=$EC2_NAME" \
              "Name=instance-state-name,Values=pending,running,stopping,stopped" \
            --query "Reservations[].Instances[].InstanceId | [0]" \
            --output text)

          if [ "$INSTANCE_ID" = "None" ] || [ -z "$INSTANCE_ID" ]; then
            echo "EC2 not found. Creating infrastructure..."

            # Get default VPC
            VPC_ID=$(aws ec2 describe-vpcs \
              --filters "Name=is-default,Values=true" \
              --query "Vpcs[0].VpcId" \
              --output text)

            if [ "$VPC_ID" = "None" ] || [ -z "$VPC_ID" ]; then
              echo "Default VPC not found"
              exit 1
            fi

            echo "Default VPC: $VPC_ID"

            # Get default subnet
            SUBNET_ID=$(aws ec2 describe-subnets \
              --filters \
                "Name=vpc-id,Values=$VPC_ID" \
                "Name=default-for-az,Values=true" \
              --query "Subnets[0].SubnetId" \
              --output text)

            if [ "$SUBNET_ID" = "None" ] || [ -z "$SUBNET_ID" ]; then
              echo "Default subnet not found"
              exit 1
            fi

            echo "Default subnet: $SUBNET_ID"

            # Check existing security group
            SG_ID=$(aws ec2 describe-security-groups \
              --filters \
                "Name=group-name,Values=$SG_NAME" \
                "Name=vpc-id,Values=$VPC_ID" \
              --query "SecurityGroups[0].GroupId" \
              --output text)

            # Create security group if missing
            if [ "$SG_ID" = "None" ] || [ -z "$SG_ID" ]; then
              SG_ID=$(aws ec2 create-security-group \
                --group-name "$SG_NAME" \
                --description "Java Tomcat security group" \
                --vpc-id "$VPC_ID" \
                --query "GroupId" \
                --output text)

              echo "Security group created: $SG_ID"
            else
              echo "Using existing security group: $SG_ID"
            fi

            # Allow SSH port
            aws ec2 authorize-security-group-ingress \
              --group-id "$SG_ID" \
              --protocol tcp \
              --port 22 \
              --cidr 0.0.0.0/0 2>/dev/null || true

            # Allow Tomcat port
            aws ec2 authorize-security-group-ingress \
              --group-id "$SG_ID" \
              --protocol tcp \
              --port 8080 \
              --cidr 0.0.0.0/0 2>/dev/null || true

            # Get latest Amazon Linux 2023 AMI
            AMI_ID=$(aws ec2 describe-images \
              --owners amazon \
              --filters \
                "Name=name,Values=al2023-ami-2023.*-kernel-6.1-x86_64" \
                "Name=architecture,Values=x86_64" \
                "Name=state,Values=available" \
              --query "sort_by(Images,&CreationDate)[-1].ImageId" \
              --output text)

            if [ "$AMI_ID" = "None" ] || [ -z "$AMI_ID" ]; then
              echo "Amazon Linux AMI not found"
              exit 1
            fi

            echo "AMI ID: $AMI_ID"

            # Create EC2
            INSTANCE_ID=$(aws ec2 run-instances \
              --image-id "$AMI_ID" \
              --instance-type t3.micro \
              --key-name "$AWS_KEY_NAME" \
              --subnet-id "$SUBNET_ID" \
              --security-group-ids "$SG_ID" \
              --associate-public-ip-address \
              --tag-specifications \
                "ResourceType=instance,Tags=[{Key=Name,Value=$EC2_NAME}]" \
              --query "Instances[0].InstanceId" \
              --output text)

            echo "New EC2 created: $INSTANCE_ID"
          else
            echo "Existing EC2 found: $INSTANCE_ID"
          fi

          # Get EC2 state
          STATE=$(aws ec2 describe-instances \
            --instance-ids "$INSTANCE_ID" \
            --query "Reservations[0].Instances[0].State.Name" \
            --output text)

          echo "Current EC2 state: $STATE"

          # Wait if EC2 is stopping
          if [ "$STATE" = "stopping" ]; then
            aws ec2 wait instance-stopped \
              --instance-ids "$INSTANCE_ID"

            STATE="stopped"
          fi

          # Start EC2 if stopped
          if [ "$STATE" = "stopped" ]; then
            echo "Starting EC2..."

            aws ec2 start-instances \
              --instance-ids "$INSTANCE_ID"
          fi

          # Wait until EC2 is ready
          aws ec2 wait instance-running \
            --instance-ids "$INSTANCE_ID"

          aws ec2 wait instance-status-ok \
            --instance-ids "$INSTANCE_ID"

          # Get public IP
          PUBLIC_IP=$(aws ec2 describe-instances \
            --instance-ids "$INSTANCE_ID" \
            --query "Reservations[0].Instances[0].PublicIpAddress" \
            --output text)

          if [ "$PUBLIC_IP" = "None" ] || [ -z "$PUBLIC_IP" ]; then
            echo "EC2 public IP not found"
            exit 1
          fi

          # Pass values to deploy job
          echo "instance_id=$INSTANCE_ID" >> "$GITHUB_OUTPUT"
          echo "public_ip=$PUBLIC_IP" >> "$GITHUB_OUTPUT"

          echo "Infrastructure is ready"
          echo "Instance ID: $INSTANCE_ID"
          echo "Public IP: $PUBLIC_IP"
